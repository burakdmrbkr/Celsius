<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Celsius.Core</RootNamespace>
    <AssemblyName>Celsius.Core</AssemblyName>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Patched LibreHardwareMonitorLib (0.9.6-celsius1). Upstream 0.9.6 crashes in
      SMBios.GetDate when a board reports an invalid BIOS date such as
      "00/00/0000": new DateTime(year, 0, 0) throws and aborts the whole
      Computer.Open(), so NO sensors work. The patch rejects month/day < 1.
      See tools/lhm-patch/. Remove once the fix lands in a published release.
    -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6-celsius1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\cpu-tjmax.json" />
  </ItemGroup>

</Project>

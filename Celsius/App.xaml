<Application x:Class="Celsius.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Celsius.ViewModels"
             xmlns:views="clr-namespace:Celsius.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palet (koyu tema) -->
            <SolidColorBrush x:Key="BgBrush" Color="#0F1115"/>
            <SolidColorBrush x:Key="CardBrush" Color="#1A1D24"/>
            <SolidColorBrush x:Key="CardAltBrush" Color="#22262F"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#2F81F7"/>
            <SolidColorBrush x:Key="GoodBrush" Color="#3FB950"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#D29922"/>
            <SolidColorBrush x:Key="BadBrush" Color="#F85149"/>
            <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#8B949E"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#30363D"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                <views:DiskView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StressViewModel}">
                <views:StressView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

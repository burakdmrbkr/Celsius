<UserControl x:Class="Celsius.Views.StressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="STRESS TEST"
                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Tüm çekirdekleri yüke sokun; uygulama yük altındaki sıcaklığı izlemeye devam eder."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,16"/>

            <Border Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">

                    <Button Command="{Binding ToggleCommand}" HorizontalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="▶  Stress Testi Başlat"/>
                                <Setter Property="Background" Value="{StaticResource GoodBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="32,16"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="■  Testi Durdur"/>
                                        <Setter Property="Background" Value="{StaticResource BadBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="Test çalışırken CPU yükü ve sıcaklığı burada canlı güncellenir."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,28"
                               HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Grid Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="İŞLEMCİ YÜKÜ" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Text="{Binding CpuLoadText}" Foreground="{StaticResource TextBrush}"
                                           FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SICAKLIK" Foreground="{StaticResource MutedBrush}" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Text="{Binding CpuTempText}" Foreground="{StaticResource TextBrush}"
                                           FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="16,10"
                            Margin="0,20,0,24" MaxWidth="480">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="BİLGİ" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0">
                        <Run Text="• Test tüm çekirdeklerde yoğun hesaplama çalıştırır ve yük altında termal davranışı gösterir."/>
                        <LineBreak/>
                        <Run Text="• AI danışman, işlemcinin kritik sıcaklık eşiğini veritabanından alır ve eşik aşılırsa bakım önerisi verir."/>
                        <LineBreak/>
                        <Run Text="• Geçmiş kaydedilmez; ölçüm yalnızca oturum boyunca bellekte tutulur."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

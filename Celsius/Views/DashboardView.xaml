<UserControl x:Class="Celsius.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Başlık kartı -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="İŞLEMCİ" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CpuName}" Foreground="{StaticResource TextBrush}"
                                   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ModelMatched}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640"/>
                        <TextBlock Text="{Binding TempSourceText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{Binding StatusBrush}" CornerRadius="16"
                            Padding="16,8" VerticalAlignment="Center" MaxWidth="300">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Anlık istatistikler -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="PAKET SICAKLIĞI" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="EN YÜKSEK ÇEKİRDEK" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CpuMaxTempText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="İŞLEMCİ YÜKÜ" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="3" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="4" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="FAN / VOLTAJ" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding FanText}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{Binding VoltageText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- AI Danışman -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="AI DANIŞMAN" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding StatusSummary}" Foreground="{Binding StatusBrush}"
                               FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusSuggestions}" Foreground="{StaticResource TextBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- Çekirdek sıcaklıkları -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ÇEKİRDEK SICAKLIKLARI" Style="{StaticResource StatLabel}"/>
                    <ItemsControl ItemsSource="{Binding CoreTemps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardAltBrush}" CornerRadius="8"
                                        Padding="10" Margin="0,8,8,0" Width="118">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding TempText}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <ProgressBar Value="{Binding Temp}" Maximum="{Binding TjMax}" Height="5"
                                                     Background="#2A2E37" BorderThickness="0"
                                                     Foreground="{Binding Color}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Celsius.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Celsius.Helpers">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="DISK SAĞLIĞI (SMART)"
                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="S.M.A.R.T. özniteliklerinden üretilen özet — CrystalDiskInfo tarzı."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,16"/>

            <!-- Yönetici uyarısı -->
            <Border Background="#3A2A00" BorderBrush="#6B4E00" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,0,0,16"
                    Visibility="{Binding HasDisks, Converter={x:Static helpers:InverseBoolToVisibilityConverter.Instance}}">
                <TextBlock Foreground="#E3B341" FontSize="12" TextWrapping="Wrap">
                    <Run Text="Disk verisi alınamadı. SMART sensörlerinin tamamı için uygulamayı "/>
                    <Run Text="Yönetici olarak çalıştırın"/>
                    <Run Text="— sensörler birkaç saniye içinde otomatik yüklenir."/>
                </TextBlock>
            </Border>

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,12" Width="300">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MediaType}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sağlık" Style="{StaticResource StatLabel}"/>
                                        <ProgressBar Value="{Binding HealthPercent}" Maximum="100" Height="6"
                                                     Background="#2A2E37" BorderThickness="0"
                                                     Foreground="{Binding HealthBrush}"
                                                     Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding HealthPercent}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="22" FontWeight="Bold" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarnBrush}"
                                                   FontSize="11" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Sıcaklık" Style="{StaticResource StatLabel}" Grid.Column="0" Grid.Row="0" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding TempText}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Kapasite" Style="{StaticResource StatLabel}" Grid.Column="0" Grid.Row="1" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding CapacityText}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Çalışma Saati" Style="{StaticResource StatLabel}" Grid.Column="0" Grid.Row="2" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PohText}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="Yeniden Ayrılan Sektör" Style="{StaticResource StatLabel}" Grid.Column="0" Grid.Row="3" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ReallocatedSectors, StringFormat={}{0:0}}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

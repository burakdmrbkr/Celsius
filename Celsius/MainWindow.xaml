<Window x:Class="Celsius.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Celsius — Akıllı Sıcaklık İzleyici"
        Width="1200" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol gezinme -->
        <Border Background="{StaticResource CardAltBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,20"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="❄" FontSize="20" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Celsius" Foreground="{StaticResource TextBrush}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Akıllı sıcaklık izleyici"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding SelectedNavIndex}"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                Padding="12,10" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Foreground="{StaticResource AccentBrush}"
                                                           FontSize="14" Width="22" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#26303C"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1E2631"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border DockPanel.Dock="Bottom" Padding="18,16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Sensör verisi yerel okunur · Geçmiş saklanmaz · Yönetici modunda önerilir"
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- İçerik -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Focusable="False"/>
    </Grid>
</Window>